# Sentry Environment Configuration
# NEVER commit real credentials to git!

# Razorpay Test Mode Credentials (Optional for offline demo/test runs, required for live Test Mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# LLM Agent Configuration (Optional - fallback deterministic demo agent operates without keys)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Sentry Service Configuration
SENTRY_HOST=127.0.0.1
SENTRY_PORT=8000
SENTRY_DB_PATH=sentry/audit/sentry.db
SENTRY_MERCHANT_ID=sentry-store
AUTONOMOUS_APPROVAL_THRESHOLD=2000
